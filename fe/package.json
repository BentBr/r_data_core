{
    "name": "r-data-core-admin",
    "description": "Admin FE for r_data_core, the MDM with pipelines and easy data orchestration.",
    "version": "0.4.10",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "pnpm generate:favicons && vue-tsc && vite build",
        "preview": "vite preview",
        "typecheck": "vue-tsc --noEmit",
        "lint": "vue-tsc --noEmit && eslint . --fix",
        "format": "prettier --write src/",
        "test": "vue-tsc --noEmit && vitest",
        "test:ui": "vitest --ui",
        "test:run": "vue-tsc --noEmit && vitest run",
        "test:coverage": "vue-tsc --noEmit && vitest run --coverage",
        "coverage": "vitest run --coverage --test-timeout=30000",
        "test:e2e": "pnpm exec playwright test --config=e2e/playwright.config.ts",
        "test:e2e:headed": "pnpm exec playwright test --config=e2e/playwright.config.ts --headed",
        "test:e2e:debug": "pnpm exec playwright test --config=e2e/playwright.config.ts --debug",
        "test:e2e:report": "pnpm exec playwright show-report e2e/playwright-report --host 0.0.0.0 --port 9323",
        "lint:e2e": "eslint e2e/",
        "generate:favicons": "node scripts/generate-favicons.js"
    },
    "dependencies": {
        "@vueuse/core": "^10.11.1",
        "lucide-vue-next": "^0.556.0",
        "pinia": "^2.3.1",
        "vue": "^3.5.42",
        "vue-router": "^4.6.4",
        "vuetify": "^3.13.3",
        "zod": "^4.5.4"
    },
    "packageManager": "pnpm@10.33.4",
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "sharp"
        ],
        "overrides": {
            "esbuild": ">=0.28.1"
        }
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.63.0",
        "@types/node": "^20.19.43",
        "@typescript-eslint/eslint-plugin": "^8.69.0",
        "@typescript-eslint/parser": "^8.69.0",
        "@vitejs/plugin-vue": "^5.2.4",
        "@vitest/coverage-v8": "^3.2.7",
        "@vitest/ui": "^3.2.7",
        "@vue/test-utils": "^2.5.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^9.1.2",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-vue": "^9.33.0",
        "jsdom": "^26.1.0",
        "prettier": "^3.9.6",
        "sharp": "^0.35.4",
        "typescript": "~5.4.5",
        "vite": "^6.4.3",
        "vite-plugin-vuetify": "^2.1.3",
        "vitest": "^3.2.7",
        "vue-eslint-parser": "^9.4.3",
        "vue-tsc": "^2.2.12"
    }
}
