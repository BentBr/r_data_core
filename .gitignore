/target
.env
*.key
x-api-key

# A contributor who pastes their key into the MCP client config rather than
# exporting it should not be able to commit it by accident. The committed
# .mcp.json holds a ${RDC_MCP_API_KEY} reference, never a literal key.
.mcp.json.local

# Editor/plugin scratch. Nothing in the repo reads it, and the MCP client
# config that is actually used is .mcp.json at the root — a second, empty
# one here would only invite edits to the wrong file.
.ai/
server.log
.idea
logs

compose.override.yaml

/coverage
/fe/coverage
# Stray profiling data from instrumented coverage runs (cargo-llvm-cov)
*.profraw

# ts-rs default output (we use TS_RS_EXPORT_DIR instead)
**/bindings/*.ts

# Mac-specific
.DS_Store

docs/superpowers
