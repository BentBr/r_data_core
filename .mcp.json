{
    "mcpServers": {
        "rdatacore": {
            "command": "docker",
            "args": [
                "compose",
                "run",
                "--rm",
                "--no-deps",
                "-T",
                "mcp-stdio"
            ],
            "env": {
                "RDC_MCP_API_KEY": "${RDC_MCP_API_KEY}"
            }
        }
    }
}
